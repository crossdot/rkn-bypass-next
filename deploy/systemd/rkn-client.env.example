# /etc/netcore/client.env — EnvironmentFile для rkn-client.service.
# Формат: KEY=VALUE (без export). Приватный ключ клиента — только в файле,
# права 0640 root:rkn (install.sh выставляет).

LISTEN_ADDR=127.0.0.1:1080
SERVER_ADDR=SERVER_IP:443
TRANSPORT=auto

CA_PATH=/etc/netcore/ca.crt
CLIENT_CERT=/etc/netcore/client.crt
CLIENT_KEY=/etc/netcore/client.key

RUST_LOG=info

# P5.3 (ADR-023): дефолты политики выбора транспорта.
# По умолчанию действуют значения ниже; раскомментировать при необходимости.
# TRANSPORT_PREFERRED=tls
# TRANSPORT_PROBE_TIMEOUT_MS=2000
# TRANSPORT_TTL_S=300
# TRANSPORT_FAIL_TTL_S=30
# TRANSPORT_PROBE_ATTEMPTS=1

# P11: env-gated метрика tokio alive_tasks (по умолчанию выключено).
# TASK_METRICS_INTERVAL_S=5
