# /etc/netcore/server.env — EnvironmentFile для rkn-server.service.
# Формат: KEY=VALUE (без export). Секреты (ключи) — только в файле,
# права 0640 root:rkn (install.sh выставляет).
#
# max_sessions НЕ здесь: это поле клиента в clients.toml
# ([[clients]] max_sessions), а не env (см. ADR-021/ADR-026).

LISTEN_ADDR=0.0.0.0:443
TRANSPORT=auto

# mTLS (ADR-021): CA + leaf, не self-signed.
CERT_PATH=/etc/netcore/server.crt
KEY_PATH=/etc/netcore/server.key
CA_PATH=/etc/netcore/ca.crt

# Адресные правила (server.address_rules) и реестр клиентов.
RULES_PATH=/etc/netcore/rules.toml
CLIENTS_PATH=/etc/netcore/clients.toml

# Логи в journald, key=value (ADR-021/ADR-023).
RUST_LOG=info

# P11: env-gated метрика tokio alive_tasks (по умолчанию выключено).
# TASK_METRICS_INTERVAL_S=5
